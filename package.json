{
  "name": "open-math-agents",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build_statements.mjs && next build",
    "start": "next start",
    "ingest": "python3 -I scripts/ingest.py ../formal-conjectures ../erdosproblems",
    "ingest:extra": "python3 -I scripts/ingest_extra.py data/sources/wikipedia_unsolved.wiki data/sources/wikipedia_conjectures.wiki data/sources/opg.json ../erdosproblems/data/problems.yaml",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/build_statements.mjs && node scripts/build_data.mjs && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "katex": "0.16.22",
    "minisearch": "7.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.3.4"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "playwright": "1.65.1",
    "typescript": "5.8.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "cf": "1.0.0-beta.31"
  },
  "type": "module"
}
