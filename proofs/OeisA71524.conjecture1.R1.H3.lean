open OMA.A71524H3 in
theorem OMA.solution : OMA.R_OeisA71524_conjecture1_R1.H3 := by
  intro n h1 h2 hz
  rcases Nat.even_or_odd' n with ⟨m, rfl | rfl⟩
  · have hs := (blocks m).1
    rw [hz, abs_zero] at hs
    exact pow_ne_zero 2 (det_ne 1 15 LEf AE (by decide) cE entsE rowsE m (by omega) (by omega))
      hs.symm
  · have hs := (blocks m).2
    rw [hz, abs_zero] at hs
    exact pow_ne_zero 2 (det_ne 3 14 LOf AO (by decide) cO entsO rowsO m (by omega) (by omega))
      hs.symm
