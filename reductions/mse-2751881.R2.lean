/-- Every positive n up to one million is three positive cubes minus one
positive cube. The two difficult residues are tested on their quotient by
nine. This reduces the bitset size while preserving exact integral identities. -/
theorem positive_window {n : ℕ} (hn : 0 < n) (hb : n ≤ 1000000) :
    ∃ d x y z : ℕ, 0 < d ∧ 0 < x ∧ 0 < y ∧ 0 < z ∧
      n+d^3=x^3+y^3+z^3 := by
  by_cases h4 : n%9=4
  · obtain ⟨d,x,y,z,hd,hx,hy,hz,h⟩ := fourth_window (k := n/9) (by omega)
    exact ⟨d,x,y,z,hd,hx,hy,hz,by rwa [show 9*(n/9)+4=n by omega] at h⟩
  by_cases h5 : n%9=5
  · obtain ⟨d,x,y,z,hd,hx,hy,hz,h⟩ := fifth_window (k := n/9) (by omega)
    exact ⟨d,x,y,z,hd,hx,hy,hz,by rwa [show 9*(n/9)+5=n by omega] at h⟩
  let seed : ℕ := 2^4 ||| 2^5
  let skip := (List.range 17).foldl (fun m j => m ||| (m <<< (9*2^j))) seed
  have off : skip.testBit n = false := by
    apply Bool.eq_false_iff.mpr
    intro h
    have hs (i : ℕ) (hi : seed.testBit i = true) : i%9=4 ∨ i%9=5 := by
      simp only [seed,Nat.testBit_or,Nat.testBit_two_pow,Bool.or_eq_true,decide_eq_true_eq] at hi
      omega
    exact (only_four_five (List.range 17) seed hs n h).elim h4 h5
