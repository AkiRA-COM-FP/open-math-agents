theorem solutions_through_one_million {n : ℕ} (pos : 0 < n) (bound : n≤1000000) :
    v_l 1 n=1 ↔ n ∈ [1,2,3,4,6,7,8,10,12,15,16,18,22,24,26,30,36,42,46,48,60,70,78,80,96,120,190,222,330] := by
  by_cases small : n≤330
  · exact solutions_through_330 pos small
  · constructor
    · intro sol
      exact (no_new_solutions_through_one_million (by omega) bound sol).elim
    · intro mem
      have cap : ∀ x ∈ ([1,2,3,4,6,7,8,10,12,15,16,18,22,24,26,30,36,42,46,48,60,70,78,80,96,120,190,222,330] : List ℕ), x≤330 := by decide
      exact (small (cap n mem)).elim


