    omega
  let n := p^2-1
  have sqpos : 0 < p^2 := pow_pos pp.pos _
  have en : n+1=p^2 := by dsimp only [n]; omega
  by_contra missing
  have sol : (¬∃ k u v : ℕ, 0 < k ∧ u.Prime ∧ v.Prime ∧ u≠v ∧ k < u ∧ k < v ∧ u∣n+k ∧ v∣n+k) := by
    rintro ⟨k,u,v,kp,pu,pv,ne,hu,hv,du,dv⟩
    have nk : n+k=p^2+(k-1) := by omega
