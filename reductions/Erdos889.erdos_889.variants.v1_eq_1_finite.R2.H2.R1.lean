private def primeTest (p : ℕ) : Bool :=
  decide (2 ≤ p) && (List.range (p.sqrt+1)).all (fun a => decide (a<2 ∨ p%a≠0))

private theorem primeTest_sound {p : ℕ} (h : primeTest p = true) : p.Prime := by
  simp only [primeTest,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true,List.mem_range] at h
  refine Nat.prime_def_le_sqrt.mpr ⟨h.1,?_⟩
  intro m low high dv
  have mlt : m < p.sqrt+1 := by omega
  have out := h.2 m mlt
  have dz := Nat.mod_eq_zero_of_dvd dv
  omega

private def covers (stop : ℕ) : ℕ → List (ℕ × ℕ × ℕ) → Bool
  | c, [] => decide (stop ≤ c)
  | c, (p,q,m)::rs =>
      (primeTest p && primeTest q && decide (p < q ∧ c < m*p*q ∧ m*p*q < c+p)) && covers stop (m*p*q) rs

private theorem covers_sound {stop c n : ℕ} {rows : List (ℕ × ℕ × ℕ)}
    (test : covers stop c rows = true) (lo : c ≤ n) (hi : n < stop) : v_l 1 n≠1 := by
  induction rows generalizing c with
  | nil => simp only [covers,decide_eq_true_eq] at test; omega
  | cons row rest ih =>
    obtain ⟨p,q,m⟩ := row
    simp only [covers,Bool.and_eq_true,decide_eq_true_eq] at test
    obtain ⟨⟨⟨pp,pq⟩,lt,low,high⟩,next⟩ := test
    by_cases past : m*p*q ≤ n
    · exact ih next past
    · let k := m*p*q-n
      have ek : n+k=m*p*q := by dsimp [k]; omega
      have kp : k < p := by dsimp [k]; omega
      have kn : 0 < k := by dsimp [k]; omega
      have dp : p∣m*p*q := dvd_mul_of_dvd_left (dvd_mul_left p m) q
      exact two_primes kn (primeTest_sound pp) (primeTest_sound pq) lt.ne kp (kp.trans lt)
        (ek ▸ dp) (ek ▸ dvd_mul_left q (m*p))

