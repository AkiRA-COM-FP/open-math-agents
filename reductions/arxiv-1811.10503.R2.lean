import OMAStatements.S_arxiv_1811_10503
import Mathlib

-- Reduction arxiv-1811.10503.R2 of On permutations of $\{1,\ldots,n\}$ and related topics
-- Credit: @ethduke
-- Each H becomes its own step once this file is accepted. Proving all of them closes the problem.

/-!
# Sun's Conjecture 4.1: the torsion case reduces to finite abelian groups

Let no element of `G` have order in `[2, n+1]`. If `x, y` have finite order and
`x ^ r = y ^ s` with `1 ≤ r, s ≤ n`, then `zpowers x = zpowers y`: every such exponent is prime
to the order of every element, so `zpowers (x ^ r) = zpowers x`. (This observation is used in
D. Ma, arXiv:2611.13582, for finite groups.) Hence, when every element of `A` has finite order, the
map sending `y` to the tuple that is `y` on the coordinates `x` with `zpowers x = zpowers y` and `1`
elsewhere embeds `A` into the finite abelian group `∏_{x ∈ A} zpowers x`. It keeps every
collision `x ^ r = y ^ s`, and that group still has no element of order in `[2, n+1]`.
A valid numbering there pulls back to `A`.

* `H1`: the conjecture for finite abelian groups (open in general; Sun's computations cover small
  cyclic groups, and Ma's preprint claims `n ≤ 6`).
* `H2`: the conjecture for sets `A` that contain an element of infinite order.

The statement quantifies over `G : Type u`; it is first moved to `Type` through the quotient of the
free group on `n` letters that maps onto the subgroup generated by `A` (the same device as in the
reduction of PR 20250).
-/

namespace OMA.R_arxiv_1811_10503_R2

def H1 : Prop := ∀ n : ℕ, 0 < n → ∀ (G : Type) [CommGroup G] [Finite G],
  (∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) → ∀ A : Finset G, A.card = n →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val + 1))

def H2 : Prop := ∀ n : ℕ, 0 < n → ∀ (G : Type) [Group G],
  (∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) → ∀ A : Finset G, A.card = n →
  (∃ x ∈ A, orderOf x = 0) →
  ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
    Function.Injective (fun i : Fin n => a i ^ (i.val + 1))

section Torsion

variable {G : Type} [Group G]

/-- An exponent `1 ≤ r ≤ n` is prime to the order of every element. -/
lemma coprime_of_noSmall {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1))
    (x : G) (hx : orderOf x ≠ 0) {r : ℕ} (hr : 1 ≤ r) (hrn : r ≤ n) :
    r.Coprime (orderOf x) := by
  by_contra h
  obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd h
  have hpr : p ∣ r := hpd.trans (Nat.gcd_dvd_left _ _)
  have hpo : p ∣ orderOf x := hpd.trans (Nat.gcd_dvd_right _ _)
  apply hG (x ^ (orderOf x / p))
  rw [orderOf_pow_orderOf_div hx hpo, Finset.mem_Icc]
  exact ⟨hp.two_le, (Nat.le_of_dvd (by omega) hpr).trans (by omega)⟩

lemma zpowers_pow_eq {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1))
    (x : G) (hx : orderOf x ≠ 0) {r : ℕ} (hr : 1 ≤ r) (hrn : r ≤ n) :
    Subgroup.zpowers (x ^ r) = Subgroup.zpowers x := by
  apply le_antisymm
  · rw [Subgroup.zpowers_le]
    exact Subgroup.pow_mem _ (Subgroup.mem_zpowers x) r
  · rw [Subgroup.zpowers_le]
    obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime (coprime_of_noSmall hG x hx hr hrn)
    have hmem : (x ^ r) ^ m ∈ Subgroup.zpowers (x ^ r) :=
      Subgroup.pow_mem _ (Subgroup.mem_zpowers (x ^ r)) m
    rwa [hm] at hmem

/-- Two elements of finite order collide only inside one cyclic subgroup. -/
lemma collide {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) {x y : G}
    (hx : orderOf x ≠ 0) (hy : orderOf y ≠ 0) {r s : ℕ} (hr : 1 ≤ r) (hrn : r ≤ n)
    (hs : 1 ≤ s) (hsn : s ≤ n) (h : x ^ r = y ^ s) :
    Subgroup.zpowers x = Subgroup.zpowers y := by
  rw [← zpowers_pow_eq hG x hx hr hrn, ← zpowers_pow_eq hG y hy hs hsn, h]

/-- The abelian model of a set of elements of finite order. -/
lemma model {n : ℕ} (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) (A : Finset G)
    (hA : ∀ x ∈ A, orderOf x ≠ 0) :
    ∃ (H : Type) (_ : CommGroup H) (_ : Finite H) (f : G → H), Set.InjOn f A ∧
      (∀ h : H, orderOf h ∉ Finset.Icc 2 (n + 1)) ∧
      ∀ x ∈ A, ∀ y ∈ A, ∀ r s : ℕ, 1 ≤ r → r ≤ n → 1 ≤ s → s ≤ n →
        x ^ r = y ^ s → f x ^ r = f y ^ s := by
  classical
  have hfin : ∀ c : A, Finite (Subgroup.zpowers (c : G)) := fun c =>
    (finite_zpowers.mpr (orderOf_pos_iff.mp (Nat.pos_of_ne_zero (hA c c.2)))).to_subtype
  let f : G → ((c : A) → Subgroup.zpowers (c : G)) := fun y c =>
    if h : Subgroup.zpowers y = Subgroup.zpowers (c : G) then
      ⟨y, h ▸ Subgroup.mem_zpowers y⟩ else 1
  have hf : ∀ (y x : G) (hx : x ∈ A), ((f y ⟨x, hx⟩ : Subgroup.zpowers x) : G) =
      if Subgroup.zpowers y = Subgroup.zpowers x then y else 1 := by
    intro y x hx
    simp only [f]
    split_ifs <;> rfl
  have hf' : ∀ (y : G) (c : A), ((f y c : Subgroup.zpowers (c : G)) : G) =
      if Subgroup.zpowers y = Subgroup.zpowers (c : G) then y else 1 := fun y c => hf y c c.2
  let hcomm : ∀ c : A, CommGroup (Subgroup.zpowers (c : G)) := fun c =>
    { (inferInstance : Group (Subgroup.zpowers (c : G))) with
      mul_comm := fun a b => (IsMulCommutative.is_comm (M := Subgroup.zpowers (c : G))).comm a b }
  refine ⟨(c : A) → Subgroup.zpowers (c : G), inferInstance, Pi.finite, f, ?_, ?_, ?_⟩
  · intro y hy z hz hyz
    by_contra hne
    have key : ∀ (x : G) (hx : x ∈ A),
        ((f y ⟨x, hx⟩ : Subgroup.zpowers x) : G) = (f z ⟨x, hx⟩ : Subgroup.zpowers x) := by
      intro x hx
      rw [hyz]
    by_cases hy1 : y = 1
    · have h := key z hz
      rw [hf, hf, if_pos (Eq.refl (Subgroup.zpowers z))] at h
      split_ifs at h with h''
      · exact hne h
      · exact hne (by rw [hy1, h])
    · have h := key y hy
      rw [hf, hf, if_pos (Eq.refl (Subgroup.zpowers y))] at h
      split_ifs at h with h''
      · exact hne h
      · exact hy1 h
  · intro h hmem
    rw [Finset.mem_Icc] at hmem
    have hne : h ≠ 1 := by
      intro h1
      rw [h1, orderOf_one] at hmem
      omega
    obtain ⟨c, hc⟩ : ∃ c, h c ≠ 1 := by
      by_contra hc
      push Not at hc
      exact hne (funext hc)
    have hdvd : orderOf (h c) ∣ orderOf h := by
      apply orderOf_dvd_of_pow_eq_one
      rw [← Pi.pow_apply, pow_orderOf_eq_one]
      rfl
    have hpos : 0 < orderOf (h c) := Nat.pos_of_dvd_of_pos hdvd (by omega)
    have h1 : orderOf (h c) ≠ 1 := by
      rwa [Ne, orderOf_eq_one_iff]
    apply hG (h c : G)
    rw [Subgroup.orderOf_coe, Finset.mem_Icc]
    exact ⟨by omega, (Nat.le_of_dvd (by omega) hdvd).trans hmem.2⟩
  · intro x hx y hy r s hr hrn hs hsn hxy
    have hz := collide hG (hA x hx) (hA y hy) hr hrn hs hsn hxy
    funext c
    rw [Pi.pow_apply, Pi.pow_apply]
    apply Subtype.ext
    rw [Subgroup.coe_pow, Subgroup.coe_pow, hf', hf']
    by_cases hc : Subgroup.zpowers x = Subgroup.zpowers (c : G)
    · rw [if_pos hc, if_pos (hz ▸ hc), hxy]
    · rw [if_neg hc, if_neg (hz ▸ hc), one_pow, one_pow]

/-- The statement for groups in `Type`, from `H1` and `H2`. -/
lemma typeVersion (h1 : H1) (h2 : H2) (n : ℕ) (hn : 0 < n) (G : Type) [Group G]
    (hG : ∀ g : G, orderOf g ∉ Finset.Icc 2 (n + 1)) (A : Finset G) (hA : A.card = n) :
    ∃ a : Fin n → G, Function.Injective a ∧ Set.range a = (A : Set G) ∧
      Function.Injective (fun i : Fin n => a i ^ (i.val + 1)) := by
  classical
  by_cases hinf : ∃ x ∈ A, orderOf x = 0
  · exact h2 n hn G hG A hA hinf
  push Not at hinf
  obtain ⟨H, _, _, f, hinj, hH, hcol⟩ := model hG A hinf
  obtain ⟨b, hb, hbr, hbp⟩ :=
    h1 n hn H hH (A.image f) (by rw [Finset.card_image_of_injOn hinj, hA])
  have hpre : ∀ i, ∃ x ∈ A, f x = b i := by
    intro i
    have hi : b i ∈ ((A.image f : Finset H) : Set H) := hbr ▸ Set.mem_range_self i
    simpa using hi
  choose a ha hfa using hpre
  refine ⟨a, ?_, ?_, ?_⟩
  · intro i j hij
    apply hb
    rw [← hfa i, ← hfa j, hij]
  · ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ha i
    · intro hx
      have hx' : f x ∈ Set.range b := by
        rw [hbr]
        simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe]
        exact ⟨x, hx, rfl⟩
      obtain ⟨i, hi⟩ := hx'
      exact ⟨i, hinj (ha i) hx (by rw [hfa i, hi])⟩
  · intro i j hij
    apply hbp
    simp only at hij ⊢
    rw [← hfa i, ← hfa j]
    exact hcol _ (ha i) _ (ha j) _ _ (by omega) (by omega) (by omega) (by omega) hij

end Torsion

theorem main : H1 → H2 → type_of% @OMA.S_arxiv_1811_10503.main := by
  classical
  intro h1 h2 n hn G _ hord A hA
  -- move to `Type`: the subgroup generated by `A` is a quotient of the free group on `n` letters
  let e : Fin n ≃ A := (Finset.equivFinOfCardEq hA).symm
  let φ : FreeGroup (Fin n) →* G := FreeGroup.lift (fun i => (e i : G))
  let Q := FreeGroup (Fin n) ⧸ φ.ker
  let ι : Q →* G := QuotientGroup.kerLift φ
  have hi : Function.Injective ι := QuotientGroup.kerLift_injective _
  let g (i : Fin n) : Q := QuotientGroup.mk (FreeGroup.of i)
  have he (i : Fin n) : ι (g i) = (e i : G) := by
    change QuotientGroup.kerLift φ (QuotientGroup.mk (FreeGroup.of i)) = _
    rw [QuotientGroup.kerLift_mk]
    exact FreeGroup.lift_apply_of
  have hg : Function.Injective g := by
    intro i j h
    apply e.injective
    apply Subtype.ext
    rw [← he, ← he, h]
  let B := Finset.univ.image g
  have hB : B.card = n := by simp [B, Finset.card_image_of_injective _ hg]
  have hQ (q : Q) : orderOf q ∉ Finset.Icc 2 (n + 1) := by
    rw [← orderOf_injective ι hi]
    exact hord _
  obtain ⟨b, hb, hr, hp⟩ := typeVersion h1 h2 n hn Q hQ B hB
  refine ⟨ι ∘ b, hi.comp hb, ?_, ?_⟩
  · rw [Set.range_comp, hr]
    ext x
    constructor
    · rintro ⟨q, hq, rfl⟩
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hq
      rw [he]
      exact (e i).property
    · intro hx
      let i := e.symm ⟨x, hx⟩
      refine ⟨g i, Finset.mem_image_of_mem _ (Finset.mem_univ _), ?_⟩
      simp [he, i]
  · intro i j h
    apply hp
    apply hi
    simpa only [map_pow, Function.comp_apply] using h

end OMA.R_arxiv_1811_10503_R2
